# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_BASIC=price_...
STRIPE_PRICE_PRO=price_...

# LLM (supports any OpenAI-compatible API)
# Examples:
#   OpenAI:    LLM_BASE_URL=https://api.openai.com/v1        LLM_MODEL=gpt-4o-mini
#   DeepSeek:  LLM_BASE_URL=https://api.deepseek.com/v1      LLM_MODEL=deepseek-chat
#   Ollama:    LLM_BASE_URL=http://localhost:11434/v1         LLM_MODEL=qwen2.5:7b
#   Groq:      LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.1-8b-instant
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# Stock Data (Alpha Vantage - free tier: https://www.alphavantage.co/support/#api-key)
ALPHA_VANTAGE_API_KEY=demo

# Email (Resend: https://resend.com)
RESEND_API_KEY=re_...
EMAIL_FROM=newsletter@yourdomain.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=StockSage

# Cron Secret (protect Vercel cron endpoints)
CRON_SECRET=change-me-in-production
